{
  "name": "@local/dsh-ride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indoor trainer and heart-rate strap inside the Harness: a BLE sidecar, an agent tool, and a ride HUD.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "lib/ride-core.js", "test/*.test.js", "client.js", "bin/ride-bridge", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
